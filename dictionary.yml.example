# Echo glossary - copy to `dictionary.yml` (auto-discovered) or set ECHO_DICTIONARY_PATH.
#
# Terms listed here are injected into LLM transcript-correction / synthesis / chat prompts as
# spelling hints only. The model is instructed to use a canonical form when the spoken fragment is
# plausibly the same word under ASR/pronunciation ambiguity AND the meeting context makes the
# reference sensible — not to sprinkle glossary nouns where they do not belong.
#
# Three equivalent shapes - pick whichever you find easiest to maintain. They all flatten to
# the same deduped list. Keep the file short (~200 terms / 600 chars when joined) so prompts
# stay focused.

# Form 1 - bare list (simplest):
# - EchoApp
# - Kotoba-Whisper
# - Yunjie Zhang
# - FOMC

# Form 2 - explicit `terms` key:
terms:
  - EchoApp
  - Kotoba-Whisper
  - FOMC

# Form 3 - cosmetic groupings (any keys; values may be lists or scalars):
# people:
#   - Yunjie Zhang
#   - 石井
# products:
#   - EchoApp
#   - EchoHub
# acronyms:
#   - FOMC
#   - ARPU
