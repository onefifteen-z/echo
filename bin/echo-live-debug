#!/usr/bin/env bash
set -euo pipefail

ECHO_DEBUG=1 \
ECHO_LIVE_ASR_LOG_INTERVAL_SECONDS="${ECHO_LIVE_ASR_LOG_INTERVAL_SECONDS:-1}" \
ECHO_LIVE_CHAR_DELAY="${ECHO_LIVE_CHAR_DELAY:-0}" \
ECHO_LIVE_CHUNK_OVERLAP_SECONDS="${ECHO_LIVE_CHUNK_OVERLAP_SECONDS:-0.15}" \
exec echo-tui --live --whisper-device mps "$@"
