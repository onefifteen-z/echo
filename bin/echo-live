#!/usr/bin/env bash
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_echo-env.sh"
trap echo_restore_terminal EXIT

# Wrapper defaults: faster ASR for local live dev (override: pass --model-id after, last wins).
ECHO_DEBUG="${ECHO_DEBUG:-0}" \
ECHO_LIVE_CHUNK_OVERLAP_SECONDS="${ECHO_LIVE_CHUNK_OVERLAP_SECONDS:-0.3}" \
"$(echo_tui_bin)" --live --live-system-authorized --whisper-device mps \
   --model-id kotoba-tech/kotoba-whisper-v2.2 "$@"
#  --model-id openai/whisper-small "$@"
