# Echo — example environment file
#
# Copy to `.env` at the repository root (and/or your working directory).
# Echo loads both paths on startup. Uncomment and set only what you need.
# Defaults match the application unless noted otherwise.

# -----------------------------------------------------------------------------
# LLM providers (set at least one route for insights + in-app chat)
# -----------------------------------------------------------------------------

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional model overrides (defaults: claude-3-5-haiku-20241022 / gpt-4o-mini)
# ECHO_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ECHO_OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible gateway (optional alternative to the keys above)
# BASE_URL=
# API_KEY=
# MODEL=

# ECHO_INSIGHT_LLM_TIMEOUT=120
# ECHO_INSIGHT_DDG_TIMEOUT=45
# ECHO_DDGS_BACKEND=auto

# -----------------------------------------------------------------------------
# ASR (Whisper / Hugging Face Hub)
# -----------------------------------------------------------------------------

# ECHO_WHISPER_DEVICE=cpu
# ECHO_WHISPER_LANGUAGE=japanese

# Corporate TLS / offline Hub (see README and echo/asr.py)
# ECHO_HF_CA_BUNDLE=/path/to/combined.pem
# ECHO_HF_INSECURE_SSL=0
# ECHO_HF_LOCAL_ONLY=0
# ECHO_HF_LOAD_LOCAL_ONLY=0
# ECHO_OFFLINE=0
# HF_HUB_OFFLINE=0
# TRANSFORMERS_OFFLINE=0

# Skip startup LLM reachability probe (split-tunnel / internal APIs)
# ECHO_ASSUME_ONLINE=0

# -----------------------------------------------------------------------------
# Live system audio (macOS `--live-system-authorized`)
# -----------------------------------------------------------------------------

# Custom system PCM source: s16le stereo 24 kHz to stdout (overrides auto helper)
# ECHO_SYSTEM_AUDIO_CMD=

# macOS 14.2+ Core Audio process tap (advanced; see README)
# ECHO_ENABLE_AUDIO_TAP=0

# -----------------------------------------------------------------------------
# Live ASR: voice gate, chunking, noise, capture queues
# (defaults from echo/config.py)
# -----------------------------------------------------------------------------

# ECHO_LIVE_MIN_RMS=0.0035
# ECHO_LIVE_ACTIVE_AMP=0.012
# ECHO_LIVE_MIN_ACTIVE_RATIO=0.015
# ECHO_LIVE_CHUNK_OVERLAP_SECONDS=0.3
# ECHO_LIVE_OVERLAP_MIN_CHARS=2
# ECHO_LIVE_SEGMENT_PAUSE_SECONDS=2.0
# ECHO_LIVE_REWRITE_STABLE_SECONDS=10.0
# ECHO_LIVE_ASR_LOG_INTERVAL_SECONDS=2.0

# ECHO_LIVE_NOISE_TOKENS=ごめん
# ECHO_LIVE_ALWAYS_DROP_NOISE_TOKENS=ごめん
# ECHO_LIVE_NOISE_MAX_CHARS=4
# ECHO_LIVE_NOISE_MAX_RMS_FACTOR=1.3
# ECHO_LIVE_NOISE_DROP_AT_SEGMENT_START=1

# Comma-separated phrases (empty = built-in default list)
# ECHO_LIVE_STOP_WORDS=

# ECHO_LIVE_METER_HISTORY_WIDTH=52

# ECHO_LIVE_CAPTURE_OUT_QUEUE_MAX=512
# ECHO_LIVE_CAPTURE_MIX_QUEUE_MAX=256
# ECHO_LIVE_CAPTURE_OUT_Q_DROP_THRESHOLD=400
# ECHO_LIVE_CAPTURE_OUT_Q_DROP_BATCH=30

# -----------------------------------------------------------------------------
# Live transcript UI segmentation
# -----------------------------------------------------------------------------

# ECHO_UI_SEGMENT_SEMANTIC_MIN_CHARS=80
# ECHO_UI_SEGMENT_MAX_SECONDS=25
# ECHO_UI_SEGMENT_MAX_CHARS=460

# -----------------------------------------------------------------------------
# Insights (`--live` scheduling and transcript rewrite)
# -----------------------------------------------------------------------------

# ECHO_INSIGHT_LIVE_MIN_SECONDS=10
# ECHO_INSIGHT_PAUSE_SECONDS=3
# ECHO_INSIGHT_PAUSE_MIN_CHARS=80
# ECHO_INSIGHT_FINALIZED_SEGMENT_MIN_CHARS=100
# ECHO_INSIGHT_SKIP_MIN_CHARS=50
# ECHO_INSIGHT_LIVE_MIN_INTERVAL=45
# ECHO_INSIGHT_PAUSE_CAPTURE_Q=400

# ECHO_ENABLE_TRANSCRIPT_REWRITE=1

# -----------------------------------------------------------------------------
# In-app chat context window
# -----------------------------------------------------------------------------

# ECHO_CHAT_CONTEXT_MAX_LINES=600

# -----------------------------------------------------------------------------
# Debug and startup UX
# -----------------------------------------------------------------------------

# ECHO_DEBUG=0
# ECHO_DEBUG_PANEL_LINES=0
# ECHO_NO_SPLASH=0
